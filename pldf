import polars as pl

def convert_to_float32(df: pl.DataFrame) -> pl.DataFrame:
    # Generate expressions to cast eligible columns
    exprs = []
    for col in df.columns:
        dtype = df[col].dtype
        if dtype == pl.Float64:
            exprs.append(pl.col(col).cast(pl.Float32))
        elif isinstance(dtype, pl.Decimal):  # Handles all Decimal types
            exprs.append(pl.col(col).cast(pl.Float32))
    
    # Apply conversions if any eligible columns exist
    if exprs:
        return df.with_columns(exprs)
    return df
